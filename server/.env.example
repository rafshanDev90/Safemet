# ============================================================
# safemete Backend - Production Environment Template
# Copy to server/.env on the cPanel server (do NOT commit .env)
# ============================================================

# Node
PORT=4000
NODE_ENV=production

# Public app base URL (used to build absolute hosted URLs, e.g. uploaded images)
APP_URL=https://safemeteinfo.com

# CORS (comma-separated list of allowed origins).
# Include the main domain AND the admin subdomain.
CORS_ORIGIN=https://safemeteinfo.com,https://www.safemeteinfo.com,https://admin.safemeteinfo.com

# MongoDB (users / auth) - create the database in MongoDB Atlas
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.mongodb.net/safemete?authSource=admin&appName=Cluster0

# JWT - generate a strong random string: openssl rand -hex 64
JWT_SECRET=replace-with-a-64-char-hex-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_MFA_TEMP_EXPIRY=5m

# Security
BCRYPT_ROUNDS=12
OTP_EXPIRY_MINUTES=5

# Email (SMTP) - use the Gmail app password, not your login password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
OTP_FROM=you@gmail.com

# Seed admin (created on first run)
SEED_ADMIN_EMAIL=admin@safemeteinfo.com
SEED_ADMIN_PASSWORD=ChangeThis!Strong123
SEED_ADMIN_NAME=Super Admin

# ------------------------------------------------------------
# Static serving paths (cPanel).
# Point these at the deployed apps so BOTH the main domain
# Node app and the admin subdomain Node app share the same
# data, uploads and frontend builds.
# ------------------------------------------------------------

# Where uploaded product images are stored (served at /uploads/
UPLOADS_DIR=/home/USERNAME/fire-safety/uploads

# Where the JSON product data store lives
DATA_DIR=/home/USERNAME/fire-safety/data

# Built frontend folders (the /dist contents of each app)
CLIENT_DIST_DIR=/home/USERNAME/fire-safety/client
ADMIN_DIST_DIR=/home/USERNAME/fire-safety/admin

# Hostname(s) that should receive the ADMIN panel instead of the public site
# (comma-separated). Empty/omitted => any host starting with "admin." is treated as admin.
ADMIN_HOSTS=admin.safemeteinfo.com